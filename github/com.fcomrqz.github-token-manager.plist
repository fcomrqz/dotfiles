<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.fcomrqz.github-token-manager</string>

    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/false</string>
      <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/com.fcomrqz.github-token-manager.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.fcomrqz.github-token-manager.stderr.log</string>
  </dict>
</plist>
