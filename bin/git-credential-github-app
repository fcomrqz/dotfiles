#!/bin/bash

set -euo pipefail

operation="${1:-get}"
[[ "$operation" == "get" ]] || exit 0

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done

[[ "$protocol" == "https" && "$host" == "github.com" ]] || exit 0

# shellcheck source=bin/github-app-token-common
source /usr/local/libexec/fcomrqz/github-app-token-common
token="$(github_app_read_token)"
printf 'username=x-access-token\n'
printf 'password=%s\n\n' "$token"
