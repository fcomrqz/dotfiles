#!/bin/bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  with-secrets PROJECT COMMAND [ARG...]

Load ~/.config/fcomrqz/secrets/PROJECT.env and replace this process with
COMMAND. Run this outside Codex so project secrets are available only to the
application process.
EOF
}

path_owner() {
  case "$(uname -s)" in
    Linux) stat -c '%u' -- "$1" ;;
    Darwin | FreeBSD) stat -f '%u' "$1" ;;
    *)
      printf 'Unsupported platform: %s\n' "$(uname -s)" >&2
      return 1
      ;;
  esac
}

path_mode() {
  case "$(uname -s)" in
    Linux) stat -c '%a' -- "$1" ;;
    Darwin | FreeBSD) stat -f '%Lp' "$1" ;;
    *)
      printf 'Unsupported platform: %s\n' "$(uname -s)" >&2
      return 1
      ;;
  esac
}

project="${1:-}"
if [[ -z "$project" ]]; then
  usage
  exit 2
fi
shift

if [[ ! "$project" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  printf 'Invalid project name: %s\n' "$project" >&2
  exit 2
fi

if [[ "$#" -eq 0 ]]; then
  usage
  exit 2
fi

readonly SECRETS_DIRECTORY="$HOME/.config/fcomrqz/secrets"
readonly SECRETS_FILE="$SECRETS_DIRECTORY/$project.env"

if [[ ! -d "$SECRETS_DIRECTORY" ]]; then
  printf 'Missing secrets directory: %s\n' "$SECRETS_DIRECTORY" >&2
  exit 1
fi
if [[ ! -f "$SECRETS_FILE" || -L "$SECRETS_FILE" ]]; then
  printf 'Missing regular secrets file: %s\n' "$SECRETS_FILE" >&2
  exit 1
fi

directory_owner="$(path_owner "$SECRETS_DIRECTORY")"
directory_mode="$(path_mode "$SECRETS_DIRECTORY")"
file_owner="$(path_owner "$SECRETS_FILE")"
file_mode="$(path_mode "$SECRETS_FILE")"

if [[ "$directory_owner" != "$(id -u)" || "$file_owner" != "$(id -u)" ]]; then
  printf 'Secrets directory and file must be owned by the current user.\n' >&2
  exit 1
fi
if (( (8#$directory_mode & 077) != 0 )); then
  printf 'Secrets directory must not be accessible by group or others: %s\n' \
    "$SECRETS_DIRECTORY" >&2
  exit 1
fi
if (( (8#$file_mode & 077) != 0 )); then
  printf 'Secrets file must not be accessible by group or others: %s\n' \
    "$SECRETS_FILE" >&2
  exit 1
fi

set -a
# This file is owned by the user and cannot be edited by Codex's default
# permission profile.
# shellcheck disable=SC1090
source "$SECRETS_FILE"
set +a

exec "$@"
