<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.fcomrqz.kanata</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Library/Application Support/com.fcomrqz.kanata/bin/kanata-launcher</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>KANATA_DEVICE_NAME</key>
      <string>HHKB-Classic</string>
      <key>KANATA_FAST_RETRY_SECONDS</key>
      <string>1</string>
      <key>KANATA_FAST_WINDOW_SECONDS</key>
      <string>30</string>
      <key>KANATA_IDLE_RETRY_SECONDS</key>
      <string>600</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Library/Logs/Kanata/kanata.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Library/Logs/Kanata/kanata.stderr.log</string>
  </dict>
</plist>
